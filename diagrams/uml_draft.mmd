
classDiagram
    class Pet {
        +String petID
        +String ownerID
        +String name
        +String type
        +String breed
        +int age
        +float weight
        +String[] healthIssues
        +String[] medications
        +String feedingSchedule
        +getUpcomingTasks() Task[]
        +viewMedicalHistory() String
    }

    class Owner {
        +String ownerID
        +String name
        +String contactInfo
        +Pet[] pets
        +viewPets() Pet[]
        +viewTasks() Task[]
        +addTask(Task) void
        +modifyTask(Task) void
        +cancelTask(taskID) void
        +addPet(Pet) void
        +removePet(petID) void
    }

    class Task {
        +String taskID
        +String taskName
        +String taskType
        +String petID
        +DateTime dueDate
        +int duration
        +int priority
        +String status
        +String recurrence
        +modifyTask() void
        +cancelTask() void
        +markComplete() void
        +isOverdue() bool
    }

    class Scheduler {
        +Task[] taskList
        +String ownerID
        +String petID
        +DateRange dateRange
        +displaySchedule() void
        +getDailySchedule(date) Task[]
        +prioritizeTasks() Task[]
        +addTaskToSchedule(Task) void
        +removeTaskFromSchedule(taskID) void
        +detectConflicts() Task[]
    }

    Owner "1" o-- "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Owner "1" --> "0..*" Task : creates
    Scheduler "1" o-- "0..*" Task : organizes
    Owner "1" ..> "1" Scheduler : uses
    